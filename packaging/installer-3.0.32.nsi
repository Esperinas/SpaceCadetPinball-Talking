Unicode true
!include "MUI2.nsh"
!include "x64.nsh"
!include "WinVer.nsh"
Name "3D Pinball Space Cadet Talking"
OutFile "../SpaceCadetPinball-Talking-3.0.32-Windows-x64-Setup.exe"
InstallDir "$LOCALAPPDATA\Programs\SpaceCadetPinball-Talking"
RequestExecutionLevel user
SetCompressor /SOLID lzma
VIProductVersion "3.0.32.0"
VIAddVersionKey /LANG=1033 "ProductName" "3D Pinball Space Cadet Talking"
VIAddVersionKey /LANG=1033 "FileDescription" "Space Cadet Talking Installer"
VIAddVersionKey /LANG=1033 "FileVersion" "3.0.32"
VIAddVersionKey /LANG=1033 "LegalCopyright" "Creatiel and respective contributors"
!define MUI_ABORTWARNING
!define MUI_FINISHPAGE_RUN "$INSTDIR\SpaceCadetPinball.exe"
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "French"
!insertmacro MUI_LANGUAGE "English"
Function .onInit
 ${IfNot} ${RunningX64}
  MessageBox MB_ICONSTOP "Windows 64 bits requis / 64-bit Windows required."
  Abort
 ${EndIf}
 ${IfNot} ${AtLeastWin10}
  MessageBox MB_ICONSTOP "Windows 10 ou 11 requis / Windows 10 or 11 required."
  Abort
 ${EndIf}
 SetShellVarContext current
FunctionEnd
Section "Jeu / Game" Main
 SectionIn RO
 SetOutPath "$INSTDIR"
 File /r "../dist/windows/*"
 WriteUninstaller "$INSTDIR\Uninstall.exe"
 CreateDirectory "$SMPROGRAMS\3D Pinball Space Cadet Talking"
 CreateShortCut "$SMPROGRAMS\3D Pinball Space Cadet Talking\3D Pinball Space Cadet Talking.lnk" "$INSTDIR\SpaceCadetPinball.exe"
 CreateShortCut "$SMPROGRAMS\3D Pinball Space Cadet Talking\Desinstaller.lnk" "$INSTDIR\Uninstall.exe"
 SetRegView 64
 WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\SpaceCadetPinballTalking" "DisplayName" "3D Pinball Space Cadet Talking"
 WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\SpaceCadetPinballTalking" "DisplayVersion" "3.0.32"
 WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\SpaceCadetPinballTalking" "Publisher" "Creatiel"
 WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\SpaceCadetPinballTalking" "UninstallString" '$\"$INSTDIR\Uninstall.exe$\"'
 WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\SpaceCadetPinballTalking" "DisplayIcon" "$INSTDIR\SpaceCadetPinball.exe"
 WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\SpaceCadetPinballTalking" "InstallLocation" "$INSTDIR"
 WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\SpaceCadetPinballTalking" "NoModify" 1
 WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\SpaceCadetPinballTalking" "NoRepair" 1
SectionEnd
Section /o "Raccourci Bureau / Desktop shortcut"
 CreateShortCut "$DESKTOP\3D Pinball Space Cadet Talking.lnk" "$INSTDIR\SpaceCadetPinball.exe"
SectionEnd
